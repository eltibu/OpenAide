<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Google Play updates the app itself and doesn't allow apps that
         install APKs, so the Play build drops the in-app updater's parts. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <!-- Play wants a demo video for a microphone foreground service. The
         Play build leaves it out: calls run while the app is on screen,
         and there's no "Hey OpenAide" while the app is closed. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        tools:node="remove" />
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            tools:node="remove" />
        <service
            android:name=".MicService"
            tools:node="remove" />
        <service
            android:name=".WakeService"
            tools:node="remove" />
    </application>
</manifest>
