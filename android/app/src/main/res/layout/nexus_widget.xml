<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: Ask Nexus (a new chat), Dictate and Voice call. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/widget_ask"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/shortcut_new"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/ask_nexus"
            android:textColor="#FF3D3929"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_dictate"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="@string/shortcut_dictate"
        android:src="@drawable/ic_shortcut_dictate" />

    <ImageView
        android:id="@+id/widget_call"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/shortcut_call"
        android:src="@drawable/ic_shortcut_call" />
</LinearLayout>
