<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-ins, keys and passwords stay on this phone: nothing goes into
     Google's cloud backup or a transfer to a new phone. Chats live on the
     server, so a new phone only needs to sign in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
